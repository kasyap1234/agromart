########## Docker Compose Settings ##########
# These are used by docker-compose.yml to configure services.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=agromart
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

########## Backend Application Settings (prefixed with APP_) ##########
# General
APP_ENV=development
APP_APPPORT=8080
APP_LOG_LEVEL=info

# Database Connection
APP_DB_HOST=${DB_HOST}
APP_DB_PORT=${DB_PORT}
APP_DB_USER=${DB_USER}
APP_DB_PASSWORD=${DB_PASSWORD}
APP_DB_NAME=${DB_NAME}

# Database Connection Pool
APP_MAX_CONNS=25
APP_MIN_CONNS=5
APP_MAX_CONN_LIFE_TIME=1h
APP_MAX_CONN_IDLE_TIME=30m
APP_HEALTH_CHECK_PERIOD=1m

# Security
APP_JWT_SECRET=supersecretjwt-change-me-for-local-dev-if-you-want

# Redis
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=redis-password

########## Migrations Settings ##########
MIGRATIONS_PATH=/root/sql/schema

########## Frontend Application Settings ##########
NEXT_PUBLIC_API_URL=http://caddy
FRONTEND_PORT=3000
NODE_ENV=development
