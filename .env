# Docker Compose Optimizations
COMPOSE_BAKE=true

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=agromart

# Backend Configuration
APP_ENV=development
APP_DB_HOST=db
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=secret
APP_DB_NAME=agromart
APP_JWT_SECRET=supersecretjwt-change-me-for-local-dev-if-you-want
MIGRATIONS_PATH=/app/sql/schema
SEED_DEV=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=agromart-files
MINIO_USE_SSL=false

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOC_TYPES=application/pdf,text/plain
IMAGE_QUALITY=85
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080
ENABLE_VIRUS_SCANNING=false
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl
