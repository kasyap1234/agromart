# Core database settings (used by docker-compose and app)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=inventory

# Connection URL (optional; some tools may use this)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# Server app configuration (viper reads APP_* keys)
APP_APPPORT=8080
APP_ENV=development
APP_DB_HOST=${DB_HOST}
APP_DB_PORT=${DB_PORT}
APP_DB_USER=${DB_USER}
APP_DB_PASSWORD=${DB_PASSWORD}
APP_DB_NAME=${DB_NAME}
JWT_SECRET=supersecretjwt
MAX_CONNS=25
MIN_CONNS=5
MAX_CONN_LIFE_TIME=1h
MAX_CONN_IDLE_TIME=30m
HEALTH_CHECK_PERIOD=1m

# Migrations
MIGRATIONS_PATH=/root/sql/schema

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
