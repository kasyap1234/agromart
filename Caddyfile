{
  # Global options
  auto_https off
  metrics
}

:80 {
  encode zstd gzip

  # Health
  @health path /health
  handle @health {
    respond "healthy" 200
  }

  # API to backend
  @api path /api*
  handle @api {
    reverse_proxy backend:8080
  }

  # Next.js dev assets and HMR (must be before default)
  @next_assets path /_next/* /static/* /favicon.ico /robots.txt /manifest*.json /logo*.png
  handle @next_assets {
    reverse_proxy client:3000
  }

  # Default: proxy everything else to client (Next.js)
  handle {
    reverse_proxy client:3000
  }
}

# TLS variant for real domains (example)
# {$CADDY_DOMAIN} {
#   encode zstd gzip
#   tls {$EMAIL_FOR_TLS}
#
#   @api path /api*
#   handle @api {
#     reverse_proxy backend:8080
#   }
#
#   handle {
#     reverse_proxy frontend:3000
#   }
# }