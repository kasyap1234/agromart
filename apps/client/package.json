{
  "name": "agromart-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run next dev -p 3000",
    "dev:turbo": "bun run next dev --turbo -p 3000",
    "build": "bun run next build",
    "build:prod": "bun run next build",
    "start": "bun run next start -p 3000",
    "start:prod": "bun run next start -p 3000",
    "lint": "bun run next lint",
    "lint:fix": "bun run next lint --fix",
    "type-check": "bun run tsc --noEmit",
    "test": "bun test --preload ./bun.test.js",
    "test:watch": "bun test --preload ./bun.test.js --watch",
    "test:coverage": "bun test --preload ./bun.test.js --coverage",
    "test:ci": "bun test --preload ./bun.test.js --coverage --reporter=json",
    "test:debug": "bun test --preload ./bun.test.js --inspect",
    "test:parallel": "bun test --preload ./bun.test.js --parallel",
    "test:jest": "bun run jest",
    "test:jest:watch": "bun run jest --watch",
    "test:jest:coverage": "bun run jest --coverage",
    "test:e2e": "bun run playwright test",
    "test:e2e:ui": "bun run playwright test --ui",
    "test:e2e:headed": "bun run playwright test --headed",
    "test:e2e:debug": "bun run playwright test --debug",
    "test:e2e:chromium": "bun run playwright test --project=chromium",
    "test:e2e:mobile": "bun run playwright test --project='Mobile Chrome'",
    "analyze": "ANALYZE=true bun run next build",
    "install-deps": "bun install",
    "clean-install": "rm -rf node_modules .next && bun install"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@radix-ui/react-accordion": "1.2.1",
    "@radix-ui/react-alert-dialog": "1.1.2",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.1",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-collapsible": "1.1.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-hover-card": "1.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-navigation-menu": "1.2.1",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.1",
    "@radix-ui/react-scroll-area": "1.2.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slider": "1.2.1",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-toast": "1.2.2",
    "@radix-ui/react-toggle": "1.1.0",
    "@radix-ui/react-toggle-group": "1.1.0",
    "@radix-ui/react-tooltip": "1.1.3",
    "@tanstack/react-table": "8.20.5",
    "axios": "1.7.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "4.1.0",
    "framer-motion": "11.15.0",
    "js-cookie": "3.0.5",
    "lucide-react": "0.460.0",
    "next": "15.5.0",
    "next-themes": "0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.53.2",
    "react-hot-toast": "2.4.1",
    "recharts": "2.13.3",
    "swr": "2.2.5",
    "tailwind-merge": "2.5.4",
    "typescript": "5.7.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.5.0",
    "@playwright/test": "1.49.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.14",
    "@types/js-cookie": "3.0.6",
    "@types/node": "22.10.2",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.0",
    "eslint-plugin-testing-library": "6.4.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "24.0.0",
    "lint-staged": "15.2.11",
    "msw": "2.6.6",
    "postcss": "8.5.6",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "4.1.12",
    "tailwindcss-animate": "1.0.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  }
}
