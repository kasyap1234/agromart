########## Backend Application Settings (prefixed with APP_) ##########
# General
APP_APPPORT=8080
APP_LOG_LEVEL=warn

# Database Connection
APP_DB_HOST=db
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
APP_DB_NAME=agromart

# Database Connection Pool (Production optimized)
APP_MAX_CONNS=50
APP_MIN_CONNS=10
APP_MAX_CONN_LIFE_TIME=2h
APP_MAX_CONN_IDLE_TIME=1h
APP_HEALTH_CHECK_PERIOD=30s

# Redis Connection
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Security (MUST CHANGE IN PRODUCTION)
APP_JWT_SECRET=CHANGE_ME_TO_A_SECURE_64_CHARACTER_SECRET_KEY_IN_PRODUCTION

########## Frontend Application Settings ##########
NEXT_PUBLIC_API_URL=http://backend:8080/api
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=AgroMart
NEXT_PUBLIC_APP_VERSION=1.0.0