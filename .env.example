########## Backend Application Settings (prefixed with APP_) ##########
# General
APP_APPPORT=8080
APP_LOG_LEVEL=info

# Database Connection
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=your-secure-password
APP_DB_NAME=agromart

# Database Connection Pool
APP_MAX_CONNS=25
APP_MIN_CONNS=5
APP_MAX_CONN_LIFE_TIME=1h
APP_MAX_CONN_IDLE_TIME=30m
APP_HEALTH_CHECK_PERIOD=1m

# Redis Connection (optional)
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=redis-password

# Security
APP_JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters

########## Frontend Application Settings ##########
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=AgroMart
NEXT_PUBLIC_APP_VERSION=1.0.0
FRONTEND_PORT=3000

########## Docker Compose Overrides (for local development) ##########
# These are often used in a docker-compose.override.yml to map ports
DB_PORT=5432
APP_PORT=8080